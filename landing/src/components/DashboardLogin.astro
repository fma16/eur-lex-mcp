---
const {
  pageTitle = "Connexion au tableau de bord",
  eyebrow = "Accès dashboard"
} = Astro.props;
---

<!doctype html>
<html lang="fr" data-theme="light" data-palette="ue" data-typo="default">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Connexion sécurisée au tableau de bord Eur-Lex MCP."
    />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle} - Eur-Lex MCP</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="nav">
      <div class="container nav-inner">
        <a class="brand" href="/" aria-label="Eur-Lex MCP">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-name">Eur-Lex</span>
          <span class="brand-tag">MCP</span>
        </a>
        <nav class="nav-cta" aria-label="Navigation secondaire">
          <a class="btn btn-sm btn-ghost" href="/">Accueil</a>
          <a class="btn btn-sm" href="https://claude.ai/" rel="noreferrer">Claude</a>
        </nav>
      </div>
    </header>

    <main class="login-main">
      <section class="container login-grid">
        <div class="login-copy">
          <div class="eyebrow">{eyebrow}</div>
          <h1>Connexion au tableau de bord.</h1>
          <p>
            Retrouvez vos quotas, vos appels MCP récents et l'état du service dans une interface
            alignée sur la nouvelle charte Eur-Lex MCP.
          </p>

        </div>

        <div class="login-card" aria-labelledby="login-title">
          <div class="card-kicker">
            <span class="status-dot" aria-hidden="true"></span>
            Service opérationnel
          </div>
          <h2 id="login-title">S'identifier</h2>
          <p>
            Utilisez le compte Google inscrit dans l'allowlist du service pour ouvrir votre
            tableau de bord.
          </p>

          <form method="post" action="/login/google">
            <button class="btn btn-primary google-btn" type="submit">
              <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="currentColor" d="M21.6 12.23c0-.74-.07-1.45-.2-2.13H12v4.03h5.4a4.6 4.6 0 0 1-2 3.02v2.51h3.23c1.89-1.74 2.97-4.31 2.97-7.43Z"></path>
                <path fill="currentColor" d="M12 22c2.7 0 4.96-.9 6.62-2.43l-3.23-2.5c-.9.6-2.05.96-3.39.96-2.6 0-4.81-1.76-5.6-4.13H3.07v2.6A10 10 0 0 0 12 22Z" opacity=".85"></path>
                <path fill="currentColor" d="M6.4 13.9a6 6 0 0 1 0-3.8V7.5H3.07a10 10 0 0 0 0 9l3.33-2.6Z" opacity=".55"></path>
                <path fill="currentColor" d="M12 5.96c1.47 0 2.79.5 3.83 1.5l2.86-2.86A10 10 0 0 0 12 2 10 10 0 0 0 3.07 7.5L6.4 10.1c.79-2.37 3-4.14 5.6-4.14Z" opacity=".7"></path>
              </svg>
              Se connecter avec Google
            </button>
          </form>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <span>© 2026 Eur-Lex MCP - Service indépendant, non affilié à l'Office des publications de l'UE.</span>
        <span class="status-pill"><span class="dot" aria-hidden="true"></span>Tous les services opérationnels</span>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf7;
    --bg-soft: #f3f1ea;
    --bg-elev: #ffffff;
    --ink: #0f1115;
    --ink-2: #2a2d34;
    --ink-3: #5b6070;
    --ink-4: #8a8f9c;
    --line: rgba(15, 17, 21, 0.1);
    --line-2: rgba(15, 17, 21, 0.06);
    --brand: #003399;
    --brand-ink: #00214d;
    --accent: #ffcc00;
    --font-display: "Source Serif 4", Georgia, serif;
    --font-ui: "Inter", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --radius: 10px;
    --radius-lg: 18px;
    --maxw: 1180px;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    min-width: 320px;
  }

  body {
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-ui);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    font-feature-settings: "ss01", "cv11";
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font: inherit;
  }

  .container {
    width: min(var(--maxw), 100%);
    margin: 0 auto;
    padding: 0 32px;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--line);
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    gap: 18px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex: 0 0 auto;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .brand-mark {
    position: relative;
    display: grid;
    width: 26px;
    height: 26px;
    place-items: center;
    border-radius: 50%;
    background: var(--brand);
  }

  .brand-mark::after {
    width: 9px;
    height: 9px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    content: "";
  }

  .brand-tag {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .nav-cta {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 0;
    height: 38px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    color: var(--ink);
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    transition: background 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .btn:hover {
    border-color: color-mix(in oklab, var(--ink) 25%, transparent);
    transform: translateY(-1px);
  }

  .btn-primary {
    border-color: var(--brand);
    background: var(--brand);
    color: #fff;
  }

  .btn-primary:hover {
    border-color: color-mix(in oklab, var(--brand) 88%, black);
    background: color-mix(in oklab, var(--brand) 88%, black);
  }

  .btn-ghost {
    background: transparent;
  }

  .btn-sm {
    height: 32px;
    padding: 0 12px;
    font-size: 13px;
  }

  .login-main {
    position: relative;
    overflow: hidden;
    min-height: calc(100vh - 129px);
    padding: 72px 0 64px;
  }

  .login-main::before {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(var(--line-2) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-2) 1px, transparent 1px);
    background-position: -1px -1px;
    background-size: 56px 56px;
    content: "";
    mask-image: radial-gradient(ellipse at 65% 38%, black 24%, transparent 74%);
    pointer-events: none;
  }

  .login-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 420px);
    gap: 56px;
    align-items: center;
  }

  .login-copy {
    max-width: 680px;
  }

  .eyebrow {
    margin-bottom: 18px;
    color: var(--ink-4);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .login-copy h1 {
    max-width: 13ch;
    margin: 0 0 22px;
    font-family: var(--font-display);
    font-size: clamp(48px, 7vw, 78px);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 0.98;
    text-wrap: balance;
  }

  .login-copy p {
    max-width: 58ch;
    margin: 0;
    color: var(--ink-3);
    font-size: 18px;
    line-height: 1.58;
    text-wrap: pretty;
  }

  .login-card {
    align-self: center;
    padding: 32px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    box-shadow:
      0 30px 60px -20px rgba(0, 0, 0, 0.18),
      0 8px 18px -8px rgba(0, 51, 153, 0.18);
  }

  .card-kicker {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 24px;
    padding: 5px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-soft);
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.16);
  }

  .login-card h2 {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .login-card p {
    margin: 0 0 26px;
    color: var(--ink-3);
    font-size: 14.5px;
    line-height: 1.6;
  }

  .login-card form {
    margin: 0;
  }

  .google-btn {
    width: 100%;
    height: 48px;
    font-size: 15px;
  }

  .footer {
    border-top: 1px solid var(--line);
    background: var(--bg-soft);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    color: var(--ink-4);
    font-size: 12.5px;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .status-pill .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.18);
  }

  @media (max-width: 980px) {
    .login-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .login-card {
      align-self: auto;
      width: min(100%, 520px);
    }

  }

  @media (max-width: 760px) {
    .container {
      padding: 0 20px;
    }

    .nav-inner {
      flex-wrap: wrap;
      padding: 10px 0;
    }

    .nav-cta {
      width: 100%;
      justify-content: space-between;
    }

    .nav-cta .btn {
      flex: 1 1 0;
    }

    .login-main {
      padding: 48px 0;
    }

    .login-copy h1 {
      font-size: clamp(42px, 15vw, 58px);
    }

    .login-copy p {
      font-size: 16px;
    }

    .login-card {
      padding: 22px;
    }

    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 1ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 1ms !important;
    }
  }
</style>
