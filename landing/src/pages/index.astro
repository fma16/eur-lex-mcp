---
const tools = [
  {
    id: "expert_search",
    name: "expert_search",
    blurb: "Recherche experte EUR-Lex en syntaxe officielle.",
    description:
      "Exécute une requête en syntaxe expert EUR-Lex (DN, FM, DTS_SUBDOM, TI...) et renvoie une liste normalisée de documents (CELEX, titre, type, date, langue).",
    args: [
      {
        name: "query",
        type: "string, requis",
        desc: "Expression EUR-Lex, ex. DN = 32016R0679 ou FM = REG AND DTS_SUBDOM = LEGISLATION"
      },
      { name: "page", type: "number", desc: "Pagination (défaut 1)" },
      { name: "page_size", type: "number", desc: "Taille de page, plafond configurable (<= 100)" },
      { name: "lang", type: "string", desc: "Langue de retour (défaut FR)" }
    ],
    sample: {
      input: "DN = 32016R0679",
      output: {
        ok: true,
        data: {
          total: 1,
          page: 1,
          results: [
            {
              celex: "32016R0679",
              title: "Règlement (UE) 2016/679 - protection des données personnelles (RGPD)",
              type: "Règlement",
              date: "2016-04-27",
              lang: "FR"
            }
          ]
        },
        error: null
      }
    }
  },
  {
    id: "get_document_by_celex",
    name: "get_document_by_celex",
    blurb: "Métadonnées d'un document par identifiant CELEX.",
    description:
      "Renvoie les métadonnées d'un document juridique européen identifié de façon stable par son CELEX : titre, type, dates, auteur, classifications EuroVoc.",
    args: [
      { name: "celex", type: "string, requis", desc: "Identifiant CELEX, ex. 32016R0679" },
      { name: "lang", type: "string", desc: "Langue (défaut FR)" }
    ],
    sample: {
      input: '{ "celex": "32016R0679" }',
      output: {
        ok: true,
        data: {
          celex: "32016R0679",
          title: "Règlement général sur la protection des données",
          author: "Parlement européen, Conseil de l'Union européenne",
          adopted: "2016-04-27",
          in_force: true,
          eurovoc: ["protection des données", "vie privée", "marché intérieur"]
        },
        error: null
      }
    }
  },
  {
    id: "get_legal_text",
    name: "get_legal_text",
    blurb: "Texte intégral, considérants ou article unique.",
    description:
      "Récupère le texte d'un document : article par article, considérants seuls, ou texte complet. Idéal pour citer ou ancrer une analyse sur un passage exact, en français par défaut.",
    args: [
      { name: "celex", type: "string, requis", desc: "Identifiant CELEX du document" },
      { name: "mode", type: "enum", desc: "article | recitals | full" },
      { name: "article", type: "string", desc: 'Numéro d\'article, ex. "6" ou "6.1.f"' },
      { name: "lang", type: "string", desc: "Langue de retour (défaut FR)" }
    ],
    sample: {
      input: '{ "celex": "32016R0679", "mode": "article", "article": "6" }',
      output: {
        ok: true,
        data: {
          celex: "32016R0679",
          article: "Article 6 - Licéité du traitement",
          paragraphs: [
            "1. Le traitement n'est licite que si, et dans la mesure où, au moins une des conditions suivantes est remplie :",
            "  a) la personne concernée a consenti au traitement...",
            "  b) le traitement est nécessaire à l'exécution d'un contrat..."
          ]
        },
        error: null
      }
    }
  },
  {
    id: "get_document_toc",
    name: "get_document_toc",
    blurb: "Table des matières : chapitres, sections, articles.",
    description:
      "Renvoie la table des matières structurée d'un document EUR-Lex (parties, titres, chapitres, sections, articles) avec numérotation et intitulés. Permet à Claude de naviguer un texte long avant d'aller chercher un article précis.",
    args: [
      { name: "celex", type: "string, requis", desc: "Identifiant CELEX" },
      { name: "lang", type: "string", desc: "Langue (défaut FR)" }
    ],
    sample: {
      input: '{ "celex": "32016R0679" }',
      output: {
        ok: true,
        data: {
          celex: "32016R0679",
          toc: [
            { level: "Chapitre I", title: "Dispositions générales", articles: ["1", "2", "3", "4"] },
            { level: "Chapitre II", title: "Principes", articles: ["5", "6", "7", "8", "9", "10", "11"] },
            { level: "Chapitre III", title: "Droits de la personne concernée", articles: ["12", "-", "23"] }
          ]
        },
        error: null
      }
    }
  }
];

const steps = [
  {
    n: "01",
    title: "S'identifier",
    body: "Connectez-vous avec un compte Google autorisé. L'accès est restreint via une allowlist d'emails ou un domaine de confiance.",
    extra: "Better Auth - Google OAuth - OIDC"
  },
  {
    n: "02",
    title: "Brancher Claude",
    body: "Ajoutez le serveur MCP distant dans Claude (web ou desktop). L'autorisation OAuth + PKCE se fait en deux clics, sans clé API à manipuler.",
    extra: "https://mcp.laugier.xyz/mcp"
  },
  {
    n: "03",
    title: "Interroger en langage naturel",
    body: "Posez vos questions juridiques à Claude. Il choisit l'outil adapté, ramène un payload structuré et cite directement les sources EUR-Lex.",
    extra: "50 appels / 5 min par utilisateur"
  }
];

const useCases = [
  {
    tag: "RGPD",
    title: "Citer l'article 6 du RGPD avec le texte exact",
    body: "Plus besoin de copier-coller depuis EUR-Lex. Claude récupère l'article, le considérant pertinent et le contexte du chapitre - tout en français, en une seule réponse.",
    prompt: "Donne-moi la base légale du consentement RGPD, article par article, avec les considérants associés."
  },
  {
    tag: "Veille",
    title: "Suivre une directive en cours de transposition",
    body: "Pose une question en langage naturel ; Claude exécute une recherche experte, ramène les actes liés et les amendements, puis te livre une note de synthèse sourcée.",
    prompt: "Liste les directives sur la cybersécurité adoptées depuis 2022, avec CELEX et date d'entrée en vigueur."
  },
  {
    tag: "Fiscalité",
    title: "Comparer deux versions d'un règlement",
    body: "Récupère la table des matières des deux versions, repère les articles modifiés, puis demande le texte complet uniquement là où ça change.",
    prompt: "Compare la structure du règlement 2017/1129 avant et après la modification de 2024."
  },
  {
    tag: "Jurisprudence",
    title: "Préparer une note pour un client",
    body: "Brief d'audience, mémo, consultation : enchaîne recherche experte, lecture d'article, et synthèse - sans quitter Claude, et sans hallucination de référence.",
    prompt: "Rédige une note sur l'article 17 du DSA et cite les considérants pertinents."
  }
];

const formatJson = (value: unknown) => (typeof value === "string" ? value : JSON.stringify(value, null, 2));
---

