                  <path fill="currentColor" d="M6.4 13.9a6 6 0 0 1 0-3.8V7.5H3.07a10 10 0 0 0 0 9l3.33-2.6Z" opacity=".55"></path>
                  <path fill="currentColor" d="M12 5.96c1.47 0 2.79.5 3.83 1.5l2.86-2.86A10 10 0 0 0 12 2 10 10 0 0 0 3.07 7.5L6.4 10.1c.79-2.37 3-4.14 5.6-4.14Z" opacity=".7"></path>
                </svg>
                Se connecter avec Google
              </a>
            </div>
          </div>

          <div class="fadein delay-2">
            <div class="terminal terminal-hero" role="figure" aria-label="Demonstration du serveur MCP">
              <div class="terminal-bar">
                <div class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></div>
              <div class="terminal-title">claude - mcp - eur-lex</div>
                <div class="terminal-spacer" aria-hidden="true"></div>
              </div>
              <div class="terminal-tabs" role="tablist" aria-label="Exemples d'appels MCP">
                <button class="terminal-tab is-active" type="button" role="tab" aria-selected="true" data-terminal-tab="0">expert_search</button>
                <button class="terminal-tab" type="button" role="tab" aria-selected="false" data-terminal-tab="1">get_legal_text</button>
                <button class="terminal-tab" type="button" role="tab" aria-selected="false" data-terminal-tab="2">get_document_toc</button>
              </div>
              <div class="terminal-body" id="hero-terminal-body" aria-live="polite">
                <span class="line tok-comment">// Claude appelle l'outil expert_search via MCP</span>
                <span class="line tok-prompt">-> tools/call expert_search</span>
                <span class="line tok-str">{`{ "query": "DN = 32016R0679", "lang": "FR" }`}</span>
              </div>
            </div>
          </div>
        </div>
        <div class="stars-ring" aria-hidden="true"></div>
      </section>

      <section class="section" id="tools">
        <div class="container">
          <div class="section-head reveal">
            <div>
              <div class="section-num">01 - Outils</div>
              <h2 class="section-title">Quatre outils, une seule promesse : pas d'invention.</h2>
            </div>
            <p class="right">
              Chaque outil renvoie un payload stable <code>{`{ ok, data, error }`}</code>. Tous sont <strong>read-only</strong> - annotés <code>readOnlyHint: true</code>, <code>destructiveHint: false</code>. Claude ne peut rien modifier sur EUR-Lex.
            </p>
          </div>

          <div class="tools reveal">
            <div class="tools-list" role="tablist" aria-label="Outils MCP">
              {
                tools.map((tool, index) => (
                  <button
                    class={`tool-row${index === 0 ? " is-active" : ""}`}
                    type="button"
                    role="tab"
                    aria-selected={index === 0 ? "true" : "false"}
                    aria-controls={`panel-${tool.id}`}
                    id={`tab-${tool.id}`}
                    data-tool-tab={tool.id}
                  >
                    <span class="tool-name">{tool.name}</span>
                    <span class="tool-blurb">{tool.blurb}</span>
                  </button>
                ))
              }
            </div>

            <div class="tool-panels">
              {
                tools.map((tool, index) => (
                  <div
                    class={`tool-detail tool-panel${index === 0 ? " is-active" : ""}`}
                    id={`panel-${tool.id}`}
                    role="tabpanel"
                    aria-labelledby={`tab-${tool.id}`}
                    data-tool-panel={tool.id}
                    hidden={index !== 0}
                  >
                    <div class="tool-detail-head">
                      <h3>{tool.name}<span>()</span></h3>
                      <div class="tool-pills">
                        <span class="tool-pill is-ok">read-only</span>
                        <span class="tool-pill">JSON - {`{ ok, data, error }`}</span>
                      </div>
                    </div>

                    <p class="desc">{tool.description}</p>

                    <div>
                      <div class="section-num param-title">Paramètres</div>
                      <div class="tool-args">
                        {
                          tool.args.map((arg) => (
                            <div class="arg-row">
                              <span>
                                <span class="arg-name">{arg.name}</span>
                                <span class="arg-type"> - {arg.type}</span>
                              </span>
                              <span class="arg-desc">{arg.desc}</span>
                            </div>
                          ))
                        }
                      </div>
                    </div>

                    <div class="terminal terminal-sample">
                      <div class="terminal-bar">
                        <div class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></div>
                        <div class="terminal-title">{tool.name} - exemple</div>
                        <div class="terminal-spacer" aria-hidden="true"></div>
                      </div>
                      <div class="terminal-body">
                        <span class="line tok-comment">// requete</span>
                        <span class="line tok-str">{tool.sample.input}</span>
                        <span class="line tok-mute"></span>
                        <span class="line tok-comment">// reponse</span>
                        <span class="line tok-key"><code>{formatJson(tool.sample.output)}</code></span>
                      </div>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="how">
        <div class="container">
          <div class="section-head reveal">
            <div>
              <div class="section-num">02 - Mise en route</div>
              <h2 class="section-title">Trois étapes, pas de clé API à gérer.</h2>
            </div>
            <p class="right">
              Le serveur tourne en Streamable HTTP sur Scaleway, derrière OAuth. Vos requêtes sont rate-limitées, journalisées de façon minimale, et n'écrivent jamais sur EUR-Lex.
            </p>
          </div>

          <div class="steps">
            {
              steps.map((step, index) => (
                <article class="step reveal" style={`transition-delay: ${index * 80}ms`}>
                  <div class="step-num"><strong>{step.n}</strong>Étape</div>
                  <h4>{step.title}</h4>
                  <p>{step.body}</p>
                  <div class="step-extra">{step.extra}</div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section" id="cases">
        <div class="container">
          <div class="section-head reveal">
            <div>
              <div class="section-num">03 - Cas d'usage</div>
              <h2 class="section-title">Pour les juristes qui veulent du texte exact, pas un résumé approximatif.</h2>
            </div>
            <p class="right">
              Eur-Lex MCP s'adresse aux avocats, fiscalistes, juristes d'entreprise et chercheurs qui travaillent sur le droit européen au quotidien - et qui ne peuvent pas se permettre une référence inventée.
            </p>
          </div>

          <div class="cases">
            {
              useCases.map((useCase, index) => (
                <article class="case reveal" style={`transition-delay: ${(index % 2) * 80}ms`}>
                  <div class="case-tag">{useCase.tag}</div>
                  <h4>{useCase.title}</h4>
                  <p>{useCase.body}</p>
                  <div class="case-prompt">"{useCase.prompt}"</div>
                </article>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <a class="brand" href="#top" aria-label="Eur-Lex MCP">
              <span class="brand-mark" aria-hidden="true"></span>
              <span class="brand-name">Eur-Lex</span>
              <span class="brand-tag">MCP</span>
            </a>
            <p>
              Serveur Model Context Protocol open-source pour interroger la base juridique EUR-Lex depuis Claude et tout client MCP compatible.
            </p>
          </div>
          <div>
            <h5>Mentions</h5>
            <ul>
              <li><a href="https://eur-lex.europa.eu/content/legal-notice/legal-notice.html" target="_blank" rel="noreferrer">Données EUR-Lex</a></li>
              <li><a href="/privacy">Politique de confidentialité</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-end">
          <span>© 2026 Eur-Lex MCP - Service indépendant, non affilié à l'Office des publications de l'UE.</span>
          <span class="status-pill"><span class="dot" aria-hidden="true"></span>Tous les services opérationnels</span>
        </div>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const themeToggle = document.querySelector(".theme-toggle");

      themeToggle?.addEventListener("click", () => {
        const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = nextTheme;
      });

      const revealItems = document.querySelectorAll(".reveal");
      if (!("IntersectionObserver" in window)) {
        revealItems.forEach((item) => item.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
        );
        revealItems.forEach((item) => observer.observe(item));
      }

      const toolTabs = Array.from(document.querySelectorAll("[data-tool-tab]"));
      const toolPanels = Array.from(document.querySelectorAll("[data-tool-panel]"));
      toolTabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const id = tab.getAttribute("data-tool-tab");
          toolTabs.forEach((item) => {
            const active = item === tab;
            item.classList.toggle("is-active", active);
            item.setAttribute("aria-selected", String(active));
          });
          toolPanels.forEach((panel) => {
            const active = panel.getAttribute("data-tool-panel") === id;
            panel.classList.toggle("is-active", active);
            panel.toggleAttribute("hidden", !active);
          });
        });
      });

      type TerminalLine = {
        t: "comment" | "prompt" | "json" | "wait" | "ok" | "out";
        text: string;
        ms?: number;
      };

      type TerminalSequence = {
        label: string;
        lines: TerminalLine[];
      };

      const sequences: TerminalSequence[] = [
        {
          label: "expert_search",
          lines: [
            { t: "comment", text: "// Claude appelle l'outil expert_search via MCP" },
            { t: "prompt", text: "-> tools/call expert_search" },
            { t: "json", text: '{ "query": "DN = 32016R0679", "lang": "FR" }' },
            { t: "wait", ms: 600, text: "... requête EUR-Lex ..." },
            { t: "ok", text: "✓ 200 OK - 1 résultat - 412 ms" },
            {
              t: "out",
              text:
                '{\n  "ok": true,\n  "data": {\n    "total": 1,\n    "results": [{\n      "celex": "32016R0679",\n      "title": "Règlement (UE) 2016/679 - RGPD",\n      "type": "Règlement",\n      "date": "2016-04-27"\n    }]\n  }\n}'
            }
          ]
        },
        {
          label: "get_legal_text",
          lines: [
            { t: "comment", text: "// Récupération de l'article 6 du RGPD" },
            { t: "prompt", text: "-> tools/call get_legal_text" },
            { t: "json", text: '{ "celex": "32016R0679", "mode": "article", "article": "6" }' },
            { t: "wait", ms: 600, text: "... récupération du texte intégral ..." },
            { t: "ok", text: "✓ 200 OK - 1 article - 318 ms" },
            {
              t: "out",
              text:
                '{\n  "article": "Article 6 - Licéité du traitement",\n  "paragraphs": [\n    "1. Le traitement n\'est licite que si...",\n    "  a) la personne concernée a consenti...",\n    "  b) le traitement est nécessaire..."\n  ]\n}'
            }
          ]
        },
        {
          label: "get_document_toc",
          lines: [
            { t: "comment", text: "// Table des matières du DSA" },
            { t: "prompt", text: "-> tools/call get_document_toc" },
            { t: "json", text: '{ "celex": "32022R2065" }' },
            { t: "wait", ms: 500, text: "... extraction TOC ..." },
            { t: "ok", text: "✓ 200 OK - 5 chapitres - 287 ms" },
            {
              t: "out",
              text:
                '[\n  "Ch. I - Dispositions générales",\n  "Ch. II - Responsabilité des prestataires",\n  "Ch. III - Diligence raisonnable",\n  "Ch. IV - Mise en oeuvre...",\n  "Ch. V - Dispositions finales"\n]'
            }
          ]
        }
      ];

      const terminalBody = document.querySelector<HTMLElement>("#hero-terminal-body");
      const terminalTabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-terminal-tab]"));
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let runId = 0;
      let activeSequence = 0;

      const lineClass = (type: TerminalLine["t"]) => {
        if (type === "comment") return "tok-comment";
        if (type === "prompt") return "tok-prompt";
        if (type === "json") return "tok-str";
        if (type === "wait") return "tok-mute";
        if (type === "ok") return "tok-ok";
        if (type === "out") return "tok-key";
        return "";
      };

      const sleep = (ms: number) => new Promise((resolve) => window.setTimeout(resolve, ms));

      const renderLine = (line: TerminalLine) => {
        const span = document.createElement("span");
        span.className = `line ${lineClass(line.t)}`;
        span.textContent = line.text;
        terminalBody?.append(span);
        return span;
      };

      const updateTerminalTabs = (index: number) => {
        terminalTabs.forEach((tab) => {
          const active = tab.getAttribute("data-terminal-tab") === String(index);
          tab.classList.toggle("is-active", active);
          tab.setAttribute("aria-selected", String(active));
        });
      };

      const renderStaticSequence = (index: number) => {
        if (!terminalBody) return;
        terminalBody.replaceChildren();
        sequences[index].lines.forEach(renderLine);
      };

      const runSequence = async (index: number) => {
        if (!terminalBody) return;
        const currentRun = ++runId;
        activeSequence = index;
        updateTerminalTabs(index);
        terminalBody.replaceChildren();

        if (reducedMotion) {
          renderStaticSequence(index);
          return;
        }

        for (const line of sequences[index].lines) {
          if (currentRun !== runId) return;

          if (line.t === "wait") {
            renderLine(line);
            await sleep(line.ms ?? 400);
            continue;
          }

          const span = document.createElement("span");
          span.className = `line ${lineClass(line.t)}`;
          const cursor = document.createElement("span");
          cursor.className = "cursor";
          terminalBody.append(span);

          for (let char = 0; char <= line.text.length; char += 1) {
            if (currentRun !== runId) return;
            span.textContent = line.text.slice(0, char);
            span.append(cursor);
            await sleep(6 + Math.random() * 8);
          }

          cursor.remove();
          span.textContent = line.text;
          await sleep(line.t === "out" ? 1400 : 240);
        }

        await sleep(2200);
        if (currentRun === runId) {
          runSequence((index + 1) % sequences.length);
        }
      };

      terminalTabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const index = Number(tab.getAttribute("data-terminal-tab") ?? activeSequence);
          runSequence(index);
        });
      });

      runSequence(0);
    </script>
  </body>
</html>

